{
  "name": "fastify-playground",
  "author": "Jani Mikkonen",
  "version": "1.0.0",
  "description": "A REST API built with Fastify and TypeScript.",
  "type": "module",
  "main": "dist/app.js",
  "private": true,
  "engines": {
    "node": "24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/janisto/fastify-playground.git"
  },
  "bugs": {
    "url": "https://github.com/janisto/fastify-playground/issues"
  },
  "license": "MIT",
  "keywords": [
    "api",
    "fastify",
    "typescript",
    "rest",
    "firebase",
    "openapi"
  ],
  "scripts": {
    "dev": "tsx --watch src/app.ts",
    "serve": "firebase emulators:start --only apphosting,firestore",
    "start": "npm run build && fastify start -l info dist/app.js",
    "deploy": "firebase deploy --only apphosting",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run tests/unit --coverage",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "qa": "npm run check:fix && npm run build:check && npm run test"
  },
  "dependencies": {
    "@fastify/accepts-serializer": "^6.0.4",
    "@fastify/autoload": "^6.4.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/request-context": "^7.0.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/under-pressure": "^9.1.0",
    "cbor2": "^2.3.0",
    "fastify": "^5.10.0",
    "fastify-cli": "^8.0.0",
    "firebase-admin": "^14.1.0",
    "typebox": "^1.3.6",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "fastify-tsconfig": "^3.0.0",
    "msw": "^2.15.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.0.16"
  }
}
