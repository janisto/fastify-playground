{
  "name": "fastify-playground",
  "author": "Jani Mikkonen",
  "version": "1.0.0",
  "description": "A REST API built with Fastify and TypeScript.",
  "type": "module",
  "main": "dist/server.js",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/janisto/fastify-playground.git"
  },
  "bugs": {
    "url": "https://github.com/janisto/fastify-playground/issues"
  },
  "license": "MIT",
  "keywords": [
    "api",
    "fastify",
    "typescript",
    "rest",
    "firebase",
    "openapi",
    "observability",
    "request-id",
    "structured-logging",
    "w3c-trace-context"
  ],
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "node scripts/clean-dist.mjs && tsc",
    "build:watch": "node scripts/clean-dist.mjs && tsc --watch",
    "typecheck": "tsc --noEmit && tsc --project tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "qa": "pnpm check:fix && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/sensible": "^6.0.7",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@fastify/under-pressure": "^9.2.1",
    "ajv-formats": "^3.0.1",
    "cbor2": "^2.4.0",
    "fastify": "^5.12.7",
    "fastify-observability": "^2.0.0",
    "fastify-plugin": "^6.0.1",
    "firebase-admin": "^14.5.0",
    "typebox": "^1.4.1",
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fast-check/vitest": "0.5.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "fast-check": "4.10.2",
    "fastify-tsconfig": "^3.0.0",
    "openapi-types": "^12.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
