{
  "name": "fastify-playground",
  "author": "Jani Mikkonen",
  "version": "1.0.0",
  "description": "A REST API built with Fastify and TypeScript.",
  "type": "module",
  "main": "dist/app.js",
  "private": true,
  "engines": {
    "node": "24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/janisto/fastify-playground.git"
  },
  "bugs": {
    "url": "https://github.com/janisto/fastify-playground/issues"
  },
  "license": "MIT",
  "keywords": [
    "api",
    "fastify",
    "typescript",
    "rest",
    "firebase",
    "openapi"
  ],
  "scripts": {
    "dev": "tsx --watch src/app.ts",
    "serve": "firebase emulators:start --only apphosting,firestore",
    "start": "npm run build && fastify start -l info dist/app.js",
    "deploy": "firebase deploy --only apphosting",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "build:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run tests/unit --coverage",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "fix": "npm run check:fix && npm run build:check && npm run test"
  },
  "dependencies": {
    "@fastify/accepts-serializer": "^6.0.3",
    "@fastify/autoload": "^6.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/request-context": "^6.2.1",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.4",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/under-pressure": "^9.0.3",
    "cbor2": "^2.0.1",
    "fastify": "^5.7.1",
    "fastify-cli": "^7.4.1",
    "firebase-admin": "^13.6.0",
    "typebox": "^1.0.78",
    "undici": "^7.18.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "^24.10.9",
    "@vitest/coverage-v8": "^4.0.17",
    "fastify-tsconfig": "^3.0.0",
    "msw": "^2.12.7",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  }
}
