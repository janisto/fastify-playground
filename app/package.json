{
  "name": "fastify-playground",
  "author": "Jani Mikkonen",
  "version": "1.0.0",
  "description": "A REST API built with Fastify and TypeScript.",
  "type": "module",
  "main": "dist/server.js",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": "24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/janisto/fastify-playground.git"
  },
  "bugs": {
    "url": "https://github.com/janisto/fastify-playground/issues"
  },
  "license": "MIT",
  "keywords": [
    "api",
    "fastify",
    "typescript",
    "rest",
    "firebase",
    "openapi",
    "observability",
    "request-id",
    "structured-logging",
    "w3c-trace-context"
  ],
  "scripts": {
    "dev": "tsx --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc --project tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "qa": "pnpm check:fix && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@fastify/under-pressure": "^9.1.0",
    "cbor2": "^2.3.0",
    "fastify": "^5.10.0",
    "fastify-observability": "^0.2.1",
    "fastify-plugin": "^6.0.0",
    "firebase-admin": "^14.1.0",
    "typebox": "^1.3.6",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "fastify-tsconfig": "^3.0.0",
    "openapi-types": "^12.1.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
