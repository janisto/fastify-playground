# Server configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Exact browser origins. Use a JSON array or comma-separated list.
# Requests without an Origin header are unaffected. Empty denies all browser origins.
CORS_ORIGINS=http://localhost:3000

# Optional GitHub token for higher API rate limits in opt-in integration tests
# Test-only: the running API never reads or forwards this credential.
# Prefer a fine-grained token without private-repository access.
GITHUB_TOKEN=
