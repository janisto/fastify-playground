# Local development uses synthetic Firebase emulators; no GCP account or ADC needed.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
LOG_LEVEL=info

# Exact browser origins; empty denies all browser origins.
# Example: CORS_ORIGINS=http://localhost:3000
CORS_ORIGINS=

FIREBASE_PROJECT_ID=demo-test
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:7010
FIRESTORE_EMULATOR_HOST=127.0.0.1:7030

# Optional token for direct GitHub client integration tests only.
# The running API never reads or forwards it.
# GITHUB_TOKEN=

# Future hosted use requires that project's ADC and both emulator variables unset.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-own-credentials.json
